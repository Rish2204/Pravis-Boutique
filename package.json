{
  "name": "pravis-boutique",
  "version": "2.0.0",
  "description": "Pravis Boutique - Premium Handloom Textiles Web Application",
  "private": true,
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "start": "nuxi start",
